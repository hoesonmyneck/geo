# ── PostgreSQL (основная БД) ───────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=geo
POSTGRES_USER=geo
POSTGRES_PASSWORD=changeme_strong_password

# ── JWT ────────────────────────────────────────────────────────────
# Генерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme_generate_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── Первый admin-аккаунт (создаётся при первом запуске) ───────────
FIRST_ADMIN_LOGIN=admin
FIRST_ADMIN_PASSWORD=changeme_admin_password

# ── Nominatim / Photon ────────────────────────────────────────────
NOMINATIM_URL=http://nominatim:8080
PHOTON_URL=http://photon:2322
NOMINATIM_PG_DSN=host=nominatim port=5432 dbname=nominatim user=nominatim password=nominatim123

# ── Внешние настройки ─────────────────────────────────────────────
# Домен для Caddy (в проде — реальный домен, в dev оставить localhost)
DOMAIN=localhost
