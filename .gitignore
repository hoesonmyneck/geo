# ── Большие бинарные файлы (скачиваются вручную / через флешку) ──────────────
data/pbf/
data/cache.sqlite
data/streets_index/
data/output/

# ── Логи (могут быть сотни МБ) ────────────────────────────────────────────────
logs/

# ── Входные / выходные данные ─────────────────────────────────────────────────
data/input/
output/

# ── Xlsx файлы в корне (тестовые данные) ──────────────────────────────────────
*.xlsx
*.csv
*.parquet

# ── РКА-парсинг: большие выходные файлы и логи (НЕ коммитить, до 3+ ГБ) ────────
rka/
*.jsonl
*.log
rka_*.txt

# ── Временные диагностические скрипты ────────────────────────────────────────
check_*.py
clean_*.py
wipe_*.py
test_*.py
inspect_*.py

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.Python

# ── Отчёты и карты (опционально, можно убрать если хочешь хранить в git) ──────
# reports/

# ── Секреты и окружение ───────────────────────────────────────────────────────
.env
*.env

# ── TLS-сертификаты домена (приватный ключ! только на сервере, НЕ в git) ───────
certs/
*.pem
*.key

# ── Docker volumes (на сервере, не в git) ─────────────────────────────────────
pgdata/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
