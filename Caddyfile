{
    # Отключить автоматический HTTPS (мы сами рулим через `tls internal`)
    auto_https off
}

# Общий набор обработчиков переиспользуется в HTTP и HTTPS блоках
(common) {
    encode gzip

    # API проксируется на backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Статические данные (places.json и т.п.)
    handle /data/* {
        uri strip_prefix /data
        root * /geo-data
        header * Cache-Control "no-cache, must-revalidate"
        file_server {
            precompressed gzip
        }
    }

    # Статика фронтенда
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# HTTP на внутреннем 80 → внешний 4000 (для локального dev: http://localhost)
:80 {
    import common
}

# HTTPS на внутреннем 443 → внешний 4443 (для прода: https://interaction.enbek.kz:4443)
# Явно указываем домены — иначе `tls internal` не знает на какое имя выпускать
# самоподписанный сертификат и TLS-хендшейк падает с ERR_SSL_PROTOCOL_ERROR.
# localhost — чтобы локально тоже можно было зайти по HTTPS если понадобится.
interaction.enbek.kz, localhost {
    tls internal
    import common
}
