{
    # Отключаем только редиректы HTTP→HTTPS (нам важно сохранить HTTP-доступ
    # по http://localhost для локалки). При этом cert-management остаётся
    # активным — `tls internal` сможет генерировать самоподписанные серты.
    auto_https disable_redirects
}

# Общий набор обработчиков переиспользуется в HTTP и HTTPS блоках
(common) {
    encode gzip

    # API проксируется на backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Статические данные (places.json и т.п.)
    handle /data/* {
        uri strip_prefix /data
        root * /geo-data
        header * Cache-Control "no-cache, must-revalidate"
        file_server {
            precompressed gzip
        }
    }

    # Статика фронтенда
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# HTTP на внутреннем 80 → внешний 4000 (для локального dev: http://localhost)
:80 {
    import common
}

# HTTPS прод: реальный wildcard-сертификат *.enbek.kz.
# Файлы лежат в ./certs на сервере и монтируются в контейнер как /certs
# (см. docker-compose, volume caddy). НЕ в git — приватный ключ.
interaction.enbek.kz {
    tls /certs/fullchain.pem /certs/privkey.pem
    import common
}

# HTTPS локально — самоподписанный (реальный серт не на localhost).
localhost {
    tls internal
    import common
}
