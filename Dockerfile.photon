# -------------------------------------------------------
# Photon 1.1.0 — fuzzy geocoder поверх Nominatim
# Base: eclipse-temurin (официальный Java, Docker Hub)
# -------------------------------------------------------
FROM eclipse-temurin:21-jre-alpine

WORKDIR /photon

# photon-1.1.0.jar должен лежать рядом с этим Dockerfile
# Скачать на сервере: curl -kLo photon-1.1.0.jar https://github.com/komoot/photon/releases/download/1.1.0/photon-1.1.0.jar
COPY photon-1.1.0.jar photon.jar

VOLUME ["/photon/photon_data"]
EXPOSE 2322

ENTRYPOINT ["java", "-jar", "photon.jar"]
